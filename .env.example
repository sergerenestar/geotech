# PostgreSQL
POSTGRES_USER=geotech
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=geotechdb

# JWT (min 256 bits — generate with: openssl rand -hex 32)
JWT_SECRET=change_me_256bit_secret
JWT_REFRESH_SECRET=change_me_256bit_refresh_secret

# AWS S3 (field photos + PDF reports)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=geotech-media-dev
AWS_REGION=ca-central-1

# Anthropic (AI assistant — Phase 2)
ANTHROPIC_API_KEY=

# Production deploy (used by GitHub Actions)
PROD_HOST=
PROD_USER=deploy
PROD_SSH_KEY=

# Next.js web app
NEXT_PUBLIC_API_URL=http://localhost

# Docker image tag (set by CI/CD)
DEPLOY_SHA=latest
